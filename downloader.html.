<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Universal Downloader</title>
<style>
  :root { color-scheme: dark; }
  body { font-family: system-ui, sans-serif; background: #0f172a; color: #eaeaea; margin: 0; padding: 20px; display: flex; flex-direction: column; align-items: center; }
  h1 { font-size: 1.4rem; color: #38bdf8; margin-bottom: 5px; text-align: center; }
  p.sub { font-size: 0.85rem; color: #94a3b8; margin-bottom: 20px; text-align: center; }
  
  .container { width: 100%; max-width: 500px; background: #1e293b; padding: 20px; border-radius: 12px; box-sizing: border-box; border: 1px solid #334155; }
  
  input[type="text"] { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #fff; margin-bottom: 15px; box-sizing: border-box; font-size: 1rem; }
  button { width: 100%; padding: 12px; border-radius: 8px; border: none; background: #2563eb; color: white; font-weight: bold; font-size: 1rem; cursor: pointer; transition: 0.2s; }
  button:hover { background: #1d4ed8; }
  button:disabled { background: #475569; cursor: wait; }
  
  .result { margin-top: 20px; display: none; background: #0f172a; padding: 15px; border-radius: 8px; border: 1px solid #334155; text-align: center; }
  .result img { max-width: 100%; border-radius: 8px; margin-bottom: 10px; }
  .result a { display: inline-block; width: 100%; padding: 12px 0; background: #10b981; color: white; text-decoration: none; border-radius: 8px; font-weight: bold; margin-top: 10px; box-sizing: border-box; }
  
  .loader { display: none; text-align: center; margin-top: 15px; color: #38bdf8; font-size: 0.9rem; }
  .error { color: #ef4444; font-size: 0.85rem; margin-top: 15px; text-align: center; display: none; }
</style>
</head>
<body>

<div class="container">
  <h1>Universal Downloader</h1>
  <p class="sub">Support YT, TikTok, FB, Douyin, XHS (Min. HD/1080p)</p>

  <input type="text" id="videoUrl" placeholder="Paste link video di sini...">
  <button id="btnDownload" onclick="prosesDownload()">Download Sekarang</button>

  <div class="loader" id="loading">⏳ Sedang mengambil video resolusi tinggi...</div>
  <div class="error" id="errorMsg"></div>

  <div class="result" id="resultBox">
    <img id="thumbnail" src="" alt="Thumbnail">
    <h3 id="title" style="font-size: 1rem; margin-bottom: 5px;"></h3>
    <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 0;">Kualitas: HD / Original</p>
    <a id="downloadLink" href="#" target="_blank">📥 Simpan Video / Foto</a>
  </div>
</div>

<script>
async function prosesDownload() {
  const url = document.getElementById('videoUrl').value.trim();
  const btn = document.getElementById('btnDownload');
  const loading = document.getElementById('loading');
  const resultBox = document.getElementById('resultBox');
  const errorMsg = document.getElementById('errorMsg');

  if (!url) {
    alert("Masukkan link dulu!");
    return;
  }

  // Reset UI
  btn.disabled = true;
  btn.innerText = 'Memproses...';
  loading.style.display = 'block';
  resultBox.style.display = 'none';
  errorMsg.style.display = 'none';

  try {
    // Kita pakai API gratis open-source: Cobalt.tools
    const response = await fetch('https://api.cobalt.tools/api/json', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        url: url,
        vQuality: '1080', // Nekat minta 1080p
        isAudioOnly: false
      })
    });

    const data = await response.json();

    if (data.status === 'error') {
      throw new Error(data.text || "Gagal mengambil video. Pastiin link bener & video nggak private.");
    }

    // Tampilkan hasil
    document.getElementById('thumbnail').src = data.thumb || '';
    document.getElementById('thumbnail').style.display = data.thumb ? 'block' : 'none';
    document.getElementById('title').innerText = "Video Siap Diunduh";
    document.getElementById('downloadLink').href = data.url;
    
    resultBox.style.display = 'block';

  } catch (error) {
    errorMsg.innerText = "❌ Error: " + error.message;
    errorMsg.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerText = 'Download Sekarang';
    loading.style.display = 'none';
  }
}
</script>
</body>
</html>
